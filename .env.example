# Slack Bot User OAuth Token (starts with xoxb-). From: Slack app > OAuth & Permissions.
SLACK_BOT_TOKEN=xoxb-...

# Slack App-Level Token (starts with xapp-) with the connections:write scope.
# From: Slack app > Basic Information > App-Level Tokens. Required for Socket Mode.
SLACK_APP_TOKEN=xapp-...

# Path to the channel->project routing config.
SLACKCC_CONFIG=./config/channels.json

# Where per-thread Claude session ids are stored.
SLACKCC_SESSIONS=./.state/sessions.json

# Path to the claude binary (defaults to "claude" on PATH).
SLACKCC_CLAUDE_BIN=claude

# T3 Code bridge: base URL of the local T3 server and a bearer token
# (mint: cd <t3code>/apps/server && node src/bin.ts auth session issue --ttl 90d --token-only)
SLACKCC_T3_URL=http://127.0.0.1:3773
SLACKCC_T3_TOKEN=
# Display name used when mirroring GUI-typed messages into Slack.
SLACKCC_T3_OWNER=Dan

# Prompt Protection Service (pps) — local judge screening guest messages.
# Run it from ~/projects/pps (scripts/run.sh). Guests fail CLOSED if it's down.
SLACKCC_PPS_URL=http://127.0.0.1:8642
